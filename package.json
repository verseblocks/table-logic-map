{
  "name": "@verseblocks/pptb-table-logic-map",
  "version": "0.1.1",
  "displayName": "Table Logic Map",
  "description": "See everything that runs on a Dataverse table: plugins, workflows, cloud flows, business rules, form scripts, PCF, data rules - organized by event and pipeline stage. Exports Markdown/JSON and is invokable by AI agents through the PPTB MCP server.",
  "main": "index.html",
  "icon": "icons/table-logic-map.svg",
  "license": "MIT",
  "author": "VerseBlocks",
  "contributors": [
    {
      "name": "VerseBlocks",
      "url": "https://github.com/VerseBlocks"
    }
  ],
  "configurations": {
    "repository": "https://github.com/verseblocks/table-logic-map",
    "website": "https://github.com/verseblocks/table-logic-map#readme",
    "readmeUrl": "https://raw.githubusercontent.com/verseblocks/table-logic-map/main/README.md"
  },
  "features": {
    "multiConnection": "none",
    "minAPI": "1.2.5"
  },
  "keywords": [
    "powerplatform",
    "power-platform",
    "dataverse",
    "dynamics-365",
    "toolbox",
    "pptb",
    "plugins",
    "flows",
    "power-automate",
    "business-rules",
    "documentation",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verseblocks/table-logic-map.git"
  },
  "bugs": {
    "url": "https://github.com/verseblocks/table-logic-map/issues"
  },
  "homepage": "https://github.com/verseblocks/table-logic-map#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "pptb.config.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build:ui && npm run build:headless",
    "build:ui": "vite build",
    "build:headless": "vite build --config vite.headless.config.mts",
    "dev-watch": "npm run build:headless && vite build --mode development --watch",
    "dev-watch:headless": "vite build --config vite.headless.config.mts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pptb-validate",
    "validate:offline": "node scripts/validate-offline.mjs",
    "finalize-package": "npm run build && npm run validate && npm shrinkwrap",
    "version-stable": "npm version patch --no-git-tag-version",
    "publish-package": "npm run finalize-package && npm publish --access public"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.339",
    "@pptb/types": "^1.2.5",
    "@pptb/validate": "^1.0.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-xml-parser": "^5.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
